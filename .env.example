# No configuration is required.
# GOOGLE_PLACES_API_KEY=   # optional: Google ratings/reviews on lunch stops; also used by `prescan.py` for exact Google Maps links (Places API (New))
# TILE_URL=                # optional: map tile server, e.g. https://api.maptiler.com/maps/outdoor/{z}/{x}/{y}.png?key=... (default: OpenStreetMap)
# TILE_ATTRIBUTION=        # optional: credit shown on the map for a custom TILE_URL
# PORT=8000   # optional; hosts such as Render and Cloud Run set this themselves
